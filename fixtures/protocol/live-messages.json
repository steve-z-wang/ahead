{
  "limits": {"pushMutations": 20, "pushBytes": 262144, "pullChanges": 50},
  "subscribe": [
    {"name": "normalized: deduplicated and sorted by UTF-16 units", "wire": "{\"type\":\"subscribe\",\"scopes\":[\"b\",\"a\",\"b\",\"\\uD83D\\uDE00\",\"\\uFFFF\"]}", "valid": true, "scopes": ["a", "b", "\uD83D\uDE00", "\uFFFF"]},
    {"name": "one scope", "wire": "{\"type\":\"subscribe\",\"scopes\":[\"only\"]}", "valid": true, "scopes": ["only"]},
    {"name": "no scopes", "wire": "{\"type\":\"subscribe\",\"scopes\":[]}", "valid": false},
    {"name": "empty scope", "wire": "{\"type\":\"subscribe\",\"scopes\":[\"a\",\"\"]}", "valid": false},
    {"name": "cursors are refused", "wire": "{\"type\":\"subscribe\",\"scopes\":[\"a\"],\"cursors\":{\"a\":1}}", "valid": false},
    {"name": "wrong type", "wire": "{\"type\":\"subscribed\",\"scopes\":[\"a\"]}", "valid": false},
    {"name": "scope must be a string", "wire": "{\"type\":\"subscribe\",\"scopes\":[1]}", "valid": false}
  ],
  "acknowledgement": [
    {"name": "confirms the requested set", "wire": "{\"type\":\"subscribed\",\"scopes\":[\"a\",\"b\"],\"rejections\":[]}", "valid": true, "scopes": ["a", "b"]},
    {"name": "order and duplicates do not matter", "wire": "{\"type\":\"subscribed\",\"scopes\":[\"b\",\"a\",\"a\"],\"rejections\":[]}", "valid": true, "scopes": ["a", "b"]},
    {"name": "unknown fields are ignored", "wire": "{\"type\":\"subscribed\",\"scopes\":[\"a\"],\"rejections\":[],\"head\":7}", "valid": true, "scopes": ["a"]},
    {"name": "a rejection is unsupported", "wire": "{\"type\":\"subscribed\",\"scopes\":[\"a\"],\"rejections\":[{\"scope\":\"a\"}]}", "valid": false},
    {"name": "rejections must be present", "wire": "{\"type\":\"subscribed\",\"scopes\":[\"a\"]}", "valid": false},
    {"name": "wrong type", "wire": "{\"type\":\"subscribe\",\"scopes\":[\"a\"],\"rejections\":[]}", "valid": false},
    {"name": "scopes required", "wire": "{\"type\":\"subscribed\",\"rejections\":[]}", "valid": false}
  ],
  "frame": [
    {"name": "acknowledgement carries a type", "wire": "{\"type\":\"subscribed\",\"scopes\":[\"a\"],\"rejections\":[]}", "kind": "acknowledged"},
    {"name": "a page never carries a type", "wire": "{\"scope\":\"a\",\"fromCursor\":3,\"toCursor\":3,\"changes\":[]}", "kind": "page"},
    {"name": "a typed page is not a page", "wire": "{\"type\":\"page\",\"scope\":\"a\",\"fromCursor\":3,\"toCursor\":3,\"changes\":[]}", "kind": "invalid"},
    {"name": "a malformed page", "wire": "{\"scope\":\"a\",\"fromCursor\":4,\"toCursor\":3,\"changes\":[]}", "kind": "invalid"},
    {"name": "not an object", "wire": "[]", "kind": "invalid"}
  ]
}
