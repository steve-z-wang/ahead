enum Status { active archived @deprecated(reason: "archive with RemoveEntries instead") }
model Entry {
 id UUID
 title String
 note String?
 at DateTime
 tags String[]
 status Status
 @@id(id)
 @@version(2)
}
mutation CreateEntry { entry Entry.create }
mutation EditEntry { entry Entry.update<title,note,at> @@version(2) }
mutation RemoveEntries { entries Entry.delete[] maybe Entry.delete? @deprecated(reason: "use entries") }
