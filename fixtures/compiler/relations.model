model Book {
 id String
 title String
 comments Comment[]
 @@id(id)
}
model Comment {
 id String
 bookId String
 text String
 book Book @reference(via: [bookId], onTargetDelete: delete)
 @@id(id)
}
mutation AddBook { book Book.create }
mutation AddComment { comment Comment.create }
model Counter { id String index Int? @deprecated(reason: "counters are not indexed") @@id(id) }
