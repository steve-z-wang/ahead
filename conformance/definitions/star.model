model Star {
  userId   UUID
  momentId UUID

  user   User   @reference(via: [userId])
  moment Moment @reference(via: [momentId])

  tags StarTag[]

  @@id(userId, momentId)
}

// The keep, on its own — a page someone else wrote, kept.
mutation KeepMoment {
  star Star.create
}

// The keep, let go of. Its declared cascade is the whole of what falls with
// it, and one act is what the queue records however wide that reaches.
mutation Unstar {
  star Star.delete
}
