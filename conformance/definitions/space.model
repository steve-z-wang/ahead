enum SpaceKind {
  personal
  group
}

model Space {
  id        UUID
  ownerId   UUID
  name      String
  kind      SpaceKind
  // A nullable prerequisite contributes no invocation when the value is null.
  avatarKey String? @requires(RemoteLabel(key: self))

  owner User @reference(via: [ownerId])

  moments Moment[]

  @@id(id)
  @@unique(ownerId, name)
}

mutation CreateSpace {
  space Space.create
}

// One `(Model, op)` pair, two acts: the name is the whole of the difference.
mutation RenameSpace {
  space Space.update<name, avatarKey, kind>
  @@version(2)
}

mutation DeleteSpace {
  space Space.delete
}
