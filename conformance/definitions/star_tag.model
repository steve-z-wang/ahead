prerequisite RemoteLabel(key String)

model StarTag {
  id       UUID
  userId   UUID
  momentId UUID
  label    String @requires(RemoteLabel(key: self))

  star Star @reference(via: [userId, momentId], onTargetDelete: delete)
  // A second relation riding a field the first already uses — which is what
  // makes a tag a MULTI-PARENT row: an act carrying the star and the moment
  // can bind both (spec 2026-08-16-slot-bindings).
  moment Moment @reference(via: [momentId])

  @@id(id)
}
